  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "outDir": "node_modules/.tsc-cache",
    "tsBuildInfoFile": "node_modules/.tsc-cache/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
